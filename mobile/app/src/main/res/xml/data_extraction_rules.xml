<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Names the rider gave places stay on this phone: not in the
     Google cloud backup, not copied to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pt_local_only.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pt_local_only.xml" />
    </device-transfer>
</data-extraction-rules>
