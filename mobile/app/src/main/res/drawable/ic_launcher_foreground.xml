<?xml version="1.0" encoding="utf-8"?>
<!--
  A trip, drawn the way the app draws one: a stop you leave (ring), the line you ride,
  the stop you arrive at (the one lit dot). Everything sits inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.88" android:scaleY="0.88">
    <!-- Shadow of the line, for depth on the gradient. -->
    <path
        android:strokeColor="#40041233"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36,75.5V62.5Q36,53.5 45,53.5H63Q72,53.5 72,44.5V37.5" />
    <!-- The line. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36,73V60Q36,51 45,51H63Q72,51 72,42V35" />
    <!-- Where you leave from: a ring, as on the trip timeline. -->
    <path
        android:fillColor="#FF1746A8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:pathData="M36,75m-8.5,0a8.5,8.5 0,1 1,17 0a8.5,8.5 0,1 1,-17 0" />
    <!-- Where you arrive: the one warm light on the icon. -->
    <path
        android:fillColor="#40041233"
        android:pathData="M72,35.5m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0" />
    <path
        android:fillColor="#FFFFC24D"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:pathData="M72,33m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />
    </group>
</vector>
